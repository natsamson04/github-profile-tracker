<%- include('partials/header') %>

<section class="history">
  <h1>Search history</h1>
  <p class="subtitle">Showing your <%= searches.length %> most recent searches from MongoDB.</p>

  <% if (searches.length === 0) { %>
    <p>No searches yet. <a href="/">Try one now.</a></p>
  <% } else { %>
    <ul class="history-list">
      <% searches.forEach(function(s) { %>
        <li class="history-item">
          <img src="<%= s.avatarUrl %>" alt="" class="avatar-sm" />
          <div class="history-body">
            <p class="history-title">
              <a href="<%= s.profileUrl %>" target="_blank" rel="noopener">
                <strong><%= s.displayName || s.username %></strong>
              </a>
              <span class="handle">@<%= s.username %></span>
            </p>
            <p class="history-meta">
              <%= s.publicRepos %> repos &middot; <%= s.followers %> followers &middot;
              searched <%= new Date(s.createdAt).toLocaleString() %>
            </p>
            <% if (s.note) { %><p class="history-note">Note: <%= s.note %></p><% } %>
          </div>
          <form action="/history/<%= s._id %>/delete" method="POST" onsubmit="return confirm('Delete this entry?')">
            <button class="btn-secondary" type="submit">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('partials/footer') %>
