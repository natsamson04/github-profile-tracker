<%- include('partials/header') %>

<section class="profile">
  <div class="profile-card">
    <img src="<%= user.avatar_url %>" alt="<%= user.login %> avatar" class="avatar" />
    <div>
      <h1><%= user.name || user.login %></h1>
      <p class="handle">@<%= user.login %></p>
      <% if (user.bio) { %><p class="bio"><%= user.bio %></p><% } %>
      <% if (user.location) { %><p class="meta">Location: <%= user.location %></p><% } %>
      <p class="stats">
        <span><strong><%= user.public_repos %></strong> repos</span>
        <span><strong><%= user.followers %></strong> followers</span>
        <span><strong><%= user.following %></strong> following</span>
      </p>
      <a class="btn" href="<%= user.html_url %>" target="_blank" rel="noopener">View on GitHub</a>
    </div>
  </div>

  <% if (search.note) { %>
    <p class="note">Your note: <em><%= search.note %></em></p>
  <% } %>

  <h2>Recent repositories</h2>
  <% if (!repos || repos.length === 0) { %>
    <p>No public repositories.</p>
  <% } else { %>
    <div class="repo-grid">
      <% repos.forEach(function(repo) { %>
        <a class="repo" href="<%= repo.html_url %>" target="_blank" rel="noopener">
          <h3><%= repo.name %></h3>
          <p><%= repo.description || 'No description provided.' %></p>
          <div class="repo-meta">
            <% if (repo.language) { %><span><%= repo.language %></span><% } %>
            <span>Stars: <%= repo.stargazers_count %></span>
            <span>Forks: <%= repo.forks_count %></span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>

  <p class="back">
    <a href="/">&larr; Search another user</a> &middot;
    <a href="/history">See history</a>
  </p>
</section>

<%- include('partials/footer') %>
