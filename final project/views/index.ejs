<%- include('partials/header') %>

<section class="hero">
  <h1>Look up any GitHub profile</h1>
  <p class="subtitle">Search by username, save the result, and revisit your history later.</p>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/search" method="POST" class="search-form">
    <label for="username">GitHub username</label>
    <input
      id="username"
      name="username"
      type="text"
      placeholder="e.g. octocat"
      required
      autocomplete="off"
    />

    <label for="note">Optional note</label>
    <input
      id="note"
      name="note"
      type="text"
      placeholder="Why are you looking them up?"
    />

    <button type="submit">Search</button>
  </form>
</section>

<%- include('partials/footer') %>
